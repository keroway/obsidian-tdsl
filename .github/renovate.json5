{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommitTypeAll(chore)",
  ],
  timezone: "Asia/Tokyo",
  labels: ["dependencies"],
  prConcurrentLimit: 5,
  // pnpm-workspace.yaml の minimumReleaseAge (4320分=3日) と揃え、公開直後のバージョンでは
  // PR自体を作らない。揃っていないと、PRは即作られるがCIのfrozen-lockfile installだけ
  // 数日間失敗し続ける（keroway/reflectorbit-lp #204 で実際に発生）。
  minimumReleaseAge: "3 days",
  packageRules: [
    {
      description: "npm: マイナー / パッチはまとめて 1 PR にしてノイズを抑える（major は個別 PR）",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "npm-minor-patch",
    },
    {
      description: "GitHub Actions: マイナー / パッチはまとめて 1 PR にしてノイズを抑える（major は個別 PR）",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "github-actions",
    },
    // リポジトリ固有の追加ルールはここに追記する。実例:
    // - cargo（Rust）を使うリポジトリ: matchManagers: ["cargo"] のグルーピングルールを追加
    //   （keroway/code-tactics, keroway/timeline-dsl の renovate.json(5) を参照）
    // - Astro / フレームワーク本体のような lockstep 依存: groupName で束ねる
    //   （keroway/astro-blog の astrojs グループを参照）
    // - major を自動更新させたくない依存: matchPackageNames + matchUpdateTypes: ["major"] + enabled: false
    // - pnpm-workspace.yaml に minimumReleaseAge が無い/npm以外のエコシステムも混在するリポジトリ:
    //   トップレベルではなく matchManagers: ["npm"] を指定した packageRule で minimumReleaseAge を
    //   スコープする（keroway/hero-fund, keroway/code-tactics の renovate.json を参照）
  ],
}
