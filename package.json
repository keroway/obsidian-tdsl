{
	"name": "obsidian-tdsl",
	"version": "1.1.0",
	"description": "Timeline DSL plugin for Obsidian — renders .tdsl code blocks as SVG",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome lint --error-on-warnings .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check --error-on-warnings . && tsc --noEmit && vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"postinstall": "lefthook install"
	},
	"keywords": [
		"obsidian-plugin",
		"timeline",
		"dsl",
		"wasm",
		"svg"
	],
	"author": "keroway",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lezer/highlight": "^1.2.3",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.11",
		"builtin-modules": "^5.3.0",
		"esbuild": "^0.28.1",
		"happy-dom": "^21.0.0",
		"lefthook": "^2.1.10",
		"obsidian": "1.14.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8",
	"dependencies": {
		"@keroway/tdsl-wasm": "^2.0.0"
	}
}
